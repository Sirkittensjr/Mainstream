{
  "name": "faytarra",
  "version": "0.1.0",
  "private": true,
  "description": "FayTarra — share what you're into. A social network for music, art, gaming, food, sport and everything else.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "seed": "tsx scripts/seed.ts",
    "reset": "rm -rf .data && npm run seed"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "next": "15.5.25",
    "postcss": "^8.4.49",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.25",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
