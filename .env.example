# ---------------------------------------------------------------------------
# RISE environment
# ---------------------------------------------------------------------------
# RISE runs out of the box with NO configuration: with no Supabase keys set it
# uses the bundled local JSON driver (./.data/rise.json) which is auto-seeded
# with realistic sample creators, posts and challenges.
#
# Point it at Supabase by filling these in (run supabase/schema.sql first,
# then `npm run seed`).
# ---------------------------------------------------------------------------

# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Storage bucket used for uploaded images/video when Supabase is configured.
# SUPABASE_STORAGE_BUCKET=rise-media

# Secret used to sign session cookies. Required for any real deployment — with
# Supabase configured the app refuses to start a session without it. A local
# demo on the bundled JSON driver falls back to a temporary per-process key.
# AUTH_SECRET=change-me-to-a-long-random-string

# Comma separated list of emails that are granted the admin role on signup.
# ADMIN_EMAILS=you@example.com
